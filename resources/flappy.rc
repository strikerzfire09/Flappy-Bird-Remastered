#include <windows.h>

// Icon for the executable (Explorer, taskbar, Alt-Tab).
FLAPPYICON ICON "..\\assets\\favicon.ico"

// Version information shown in file properties.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FlappyBird"
            VALUE "FileDescription", "Flappy Bird - C++ clone"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "flappybird"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "flappybird.exe"
            VALUE "ProductName", "Flappy Bird"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
